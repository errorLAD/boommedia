# ==============================================================================
# BoomMedia Production Environment Variables (.env.example)
# Use this template to configure your Vercel Project Settings > Environment Variables
# ==============================================================================

# Database (MongoDB Atlas)
# In Vercel, use your MongoDB Atlas connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/boommedia?retryWrites=true&w=majority

# Authentication (NextAuth.js v5)
# Generate a secret via: openssl rand -base64 32
AUTH_SECRET=your-random-32-character-secret-key-here
NEXTAUTH_SECRET=your-random-32-character-secret-key-here
NEXTAUTH_URL=https://boommedia.in

# Public Application URLs
NEXT_PUBLIC_APP_URL=https://boommedia.in

# Admin Platform Security
ADMIN_SETUP_SECRET=your-secure-admin-setup-secret

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Transactional Email (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=BoomMedia <support@boommedia.in>

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Optional: Seed flag (keep false in production)
ALLOW_DANGEROUS_SEED=false
